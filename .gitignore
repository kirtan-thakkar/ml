# Indian Railways Project .gitignore

# Large Datasets & Submissions (Never commit 1.5M row CSVs)
data/
*.csv
submission.csv

# Python Bytecode & Caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Jupyter Notebook Checkpoints
.ipynb_checkpoints/

# Virtual Environments
venv/
.venv/
env/
ENV/

# Secrets and Environment Variables
.env
.env.*
*.local
secrets.toml
.streamlit/secrets.toml

# IDE & OS Metadata
.vscode/
.idea/
.DS_Store
Thumbs.db
